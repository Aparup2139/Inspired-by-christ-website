---
import { organization } from '../config/organization';

interface Props {
  path: string;
}
const { path } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/our-work/', label: 'Our Work' },
  { href: '/contact/', label: 'Contact' },
];
const { logo } = organization;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      {logo && <img src={logo.src} alt="" width={logo.width} height={logo.height} />}
      <span>{organization.brandName}</span>
    </a>
    <!-- Shown only when /js/menu.js runs; without JavaScript the links are always visible. -->
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span class="menu-icon" aria-hidden="true"></span>
      Menu
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.href === path ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
