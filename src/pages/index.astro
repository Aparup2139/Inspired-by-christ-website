---
import BaseLayout from '../layouts/BaseLayout.astro';
import Fact from '../components/Fact.astro';
import Email from '../components/Email.astro';
import { organization as org, namesDiffer } from '../config/organization';
---

<BaseLayout description={org.mission ?? `${org.brandName}: who we are, what we do, and how to contact us.`}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <h1 id="hero-title" class="hero-logo">
        <img src="/assets/logo-hero.png" alt={org.brandName} width="738" height="418" fetchpriority="high" />
      </h1>
      <p class="hero-motto">Be bold in your faith.</p>
    </div>
  </section>

  {
    (org.appStoreUrl || org.googlePlayUrl) && (
      <section class="app-band" aria-labelledby="app-title">
        <div class="container app-inner">
          <div>
            <p class="kicker">Our app</p>
            <h2 id="app-title">Download our app</h2>
          </div>
          <div class="actions">
            {org.appStoreUrl && (
              <a class="button button-primary" href={org.appStoreUrl} rel="noopener noreferrer">
                Download on the App Store
              </a>
            )}
            {org.googlePlayUrl && (
              <a class="button button-secondary" href={org.googlePlayUrl} rel="noopener noreferrer">
                Get it on Google Play
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="who-title">
    <div class="container split">
      <div>
        <p class="kicker">Who we are</p>
        <h2 id="who-title">The organization behind {org.brandName}</h2>
      </div>
      <div class="prose">
        <dl class="facts">
          <div>
            <dt>Legal name</dt>
            <dd><Fact value={org.legalEntityName} field="legalEntityName" /></dd>
          </div>
          <div>
            <dt>Legal form</dt>
            <dd><Fact value={org.legalEntityType} field="legalEntityType" /></dd>
          </div>
          {namesDiffer() && (
            <div>
              <dt>Relationship to {org.brandName}</dt>
              <dd><Fact value={org.brandRelationship} field="brandRelationship" /></dd>
            </div>
          )}
        </dl>
        <p><Fact value={org.mission} field="mission" /></p>
        <p><a href="/about/">Read more about our organization</a></p>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="contact-title">
    <div class="container contact-band">
      <div>
        <p class="kicker">Contact</p>
        <h2 id="contact-title">Get in touch</h2>
      </div>
      <div class="prose">
        <p>The best way to reach us is by email: <Email /></p>
        <p><a href="/contact/">View all contact details</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
